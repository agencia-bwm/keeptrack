---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icone from '../components/Icone.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Mapa from '../components/Mapa.astro';
import { getSite, linkWhatsApp, formatarTelefone } from '../lib/utils';
import { schemaBreadcrumb } from '../lib/schema';
const site = await getSite();
const migalhas = [{ nome: 'Início', url: '/' }, { nome: 'Contato', url: '/contato/' }];
const schema = [schemaBreadcrumb(migalhas, Astro.site!), { '@type': 'ContactPage', name: 'Contato KeepTrack 4x4', url: new URL('/contato/', Astro.site).href }];
---
<BaseLayout titulo="Contato | KeepTrack 4x4 Brotas-SP"
  descricao="Fale com a KeepTrack 4x4 pelo WhatsApp: treinamentos de condução 4x4 no Haras Tuiuti (SP), expedições off-road e eventos corporativos."
  schema={schema}>
  <PageHero titulo="Fale com a gente" eyebrow="Contato" migalhas={migalhas}
    subtitulo="O jeito mais rápido é o WhatsApp: você fala direto com a equipe que organiza os treinamentos e as viagens." />

  <section class="secao">
    <div class="container contato">
      <!-- WhatsApp: canal principal, em destaque -->
      <div class="wa-bloco topo moldura">
        <div class="wa-topo">
          <span class="wa-icone"><Icone nome="whatsapp" /></span>
          <div>
            <h2>WhatsApp</h2>
            <p>Datas, valores e inscrições direto com a equipe.</p>
          </div>
        </div>
        <ul class="wa-numeros">
          <li>
            <span class="wa-rot">Principal</span>
            <strong>{formatarTelefone(site.whatsappPrincipal)}</strong>
            <a class="btn btn--wa" href={linkWhatsApp(site.whatsappPrincipal, site.whatsappTexto)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="contato">
              <Icone nome="whatsapp" />Iniciar conversa
            </a>
          </li>
          {site.whatsappSecundario && (
            <li>
              <span class="wa-rot">Alternativo</span>
              <strong>{formatarTelefone(site.whatsappSecundario)}</strong>
              <a class="btn btn--contorno-claro" href={linkWhatsApp(site.whatsappSecundario, site.whatsappTexto)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="contato-2">
                <Icone nome="whatsapp" />Iniciar conversa
              </a>
            </li>
          )}
        </ul>
        <p class="wa-horario"><Icone nome="relogio" />{site.horario}</p>
      </div>

      <!-- Outros canais -->
      <div class="outros">
        <h2 class="outros-titulo">Outros canais</h2>
        <ul class="canais">
          <li>
            <a href={`mailto:${site.email}`} data-track="click_email" data-local="contato">
              <span class="c-icone"><Icone nome="email" /></span>
              <span class="c-texto"><span class="c-rot">E-mail</span><strong>{site.email}</strong></span>
              <span class="c-seta" aria-hidden="true"><Icone nome="seta" /></span>
            </a>
          </li>
          <li>
            <a href={site.instagram} target="_blank" rel="noopener" data-track="click_instagram" data-local="contato">
              <span class="c-icone"><Icone nome="instagram" /></span>
              <span class="c-texto"><span class="c-rot">Instagram</span><strong>@keeptrack4x4</strong></span>
              <span class="c-seta" aria-hidden="true"><Icone nome="seta" /></span>
            </a>
          </li>
          {site.youtube && (
            <li>
              <a href={site.youtube} target="_blank" rel="noopener" data-track="click_youtube" data-local="contato">
                <span class="c-icone"><Icone nome="youtube" /></span>
                <span class="c-texto"><span class="c-rot">YouTube</span><strong>@keeptrack4x4</strong></span>
                <span class="c-seta" aria-hidden="true"><Icone nome="seta" /></span>
              </a>
            </li>
          )}
          <li>
            <a href={site.facebook} target="_blank" rel="noopener" data-track="click_facebook" data-local="contato">
              <span class="c-icone"><Icone nome="facebook" /></span>
              <span class="c-texto"><span class="c-rot">Facebook</span><strong>KeepTrack4x4</strong></span>
              <span class="c-seta" aria-hidden="true"><Icone nome="seta" /></span>
            </a>
          </li>
        </ul>
        <p class="outros-nota">Para empresas: peça uma proposta de <a href="/treinamentos/corporativo/">treinamento corporativo</a>.</p>
      </div>
    </div>
  </section>

  <section class="secao secao--bege">
    <div class="container local">
      <div>
        <p class="eyebrow">Onde treinamos</p>
        <h2>{site.local.nome}</h2>
        <p>{site.local.endereco}. A pista off-road do haras recebe as turmas do treinamento Técnicas de Condução 4x4.</p>
        <a class="btn" href={site.local.mapsUrl} target="_blank" rel="noopener" data-track="click_mapa" data-local="contato"><Icone nome="local" />Abrir no Google Maps</a>
      </div>
      <Mapa nome={site.local.nome} cidade={site.local.cidade} uf={site.uf} mapsUrl={site.local.mapsUrl} />
    </div>
  </section>
  <CTAFinal />
</BaseLayout>
<style>
  .contato { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(20px, 3vw, 40px); align-items: stretch; }

  /* Bloco WhatsApp */
  .wa-bloco { background: radial-gradient(600px 300px at 100% 0%, rgb(63 104 185 / .45), transparent 60%), var(--azul-escuro); color: #dfe6f5; border-radius: var(--raio-g); padding: clamp(1.6rem, 3.5vw, 2.8rem); display: flex; flex-direction: column; gap: 1.6rem; box-shadow: var(--sombra-forte); overflow: hidden; }
  .wa-topo { display: flex; gap: 1.1rem; align-items: center; }
  .wa-icone { flex: none; width: 60px; height: 60px; display: grid; place-items: center; border-radius: var(--raio); background: #25d366; color: #fff; }
  .wa-icone :global(svg) { width: 32px; height: 32px; }
  .wa-topo h2 { color: #fff; font-size: clamp(2rem, 3.4vw, 2.6rem); margin: 0; }
  .wa-topo p { margin: .2rem 0 0; color: #c5d0ea; }
  .wa-numeros { list-style: none; margin: 0; padding: 0; display: grid; gap: .8rem; }
  .wa-numeros li { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "rot btn" "num btn"; align-items: center; column-gap: 1rem; padding: 1rem 1.1rem; border-radius: var(--raio); background: rgb(255 255 255 / .06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1); }
  .wa-rot { grid-area: rot; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: #9fb6e6; }
  .wa-numeros strong { grid-area: num; font-family: var(--f-titulo); font-size: clamp(1.6rem, 2.6vw, 2rem); font-weight: 700; color: #fff; letter-spacing: .02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .wa-numeros .btn { grid-area: btn; min-height: 46px; font-size: 1rem; }
  .wa-horario { display: flex; align-items: center; gap: .5em; margin: auto 0 0; color: #c5d0ea; font-size: .98rem; }
  .wa-horario :global(svg) { width: 18px; color: #9fb6e6; }

  /* Outros canais */
  .outros { display: flex; flex-direction: column; }
  .outros-titulo { font-size: 1.15rem; letter-spacing: .14em; color: var(--cinza); margin: .4rem 0 1rem; }
  .canais { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linha); }
  .canais li { border-bottom: 1px solid var(--linha); }
  .canais a { display: flex; align-items: center; gap: 1rem; padding: 1.25rem .25rem; text-decoration: none; color: var(--tinta); transition: background-color .2s, padding .25s var(--ease); }
  .canais a:hover { background: var(--bege); padding-inline: .9rem; color: var(--tinta); }
  .c-icone { flex: none; width: 48px; height: 48px; display: grid; place-items: center; border-radius: var(--raio); background: rgb(63 104 185 / .1); color: var(--azul); }
  .c-icone :global(svg) { width: 24px; }
  .c-texto { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .c-rot { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--cinza); }
  .c-texto strong { font-size: 1.15rem; overflow-wrap: anywhere; color: var(--azul-escuro); }
  .c-seta { flex: none; color: var(--azul); transition: transform .25s var(--ease); }
  .c-seta :global(svg) { width: 22px; }
  .canais a:hover .c-seta { transform: translateX(4px); }
  .outros-nota { margin: 1.4rem 0 0; color: var(--cinza); }

  @media (max-width: 900px) { .contato { grid-template-columns: 1fr; } }
  @media (max-width: 460px) {
    .wa-numeros li { grid-template-columns: 1fr; grid-template-areas: "rot" "num" "btn"; row-gap: .5rem; }
    .wa-numeros .btn { width: 100%; }
  }
  .local { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem 4rem; align-items: center; }
  .local .btn { margin-top: .5rem; }
  @media (max-width: 820px) { .local { grid-template-columns: 1fr; } }
</style>
