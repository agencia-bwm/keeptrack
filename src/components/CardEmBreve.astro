---
// Card "Em breve mais destinos" no fim da lista de próximas viagens
import Icone from './Icone.astro';
import { getSite, linkWhatsApp } from '../lib/utils';
const site = await getSite();
---
<article class="em-breve topo">
  <Icone nome="bussola" />
  <p class="eyebrow eyebrow--claro">Em breve</p>
  <h3>Mais destinos a caminho</h3>
  <p>Novos roteiros estão sendo preparados. Quem está na lista do WhatsApp fica sabendo primeiro.</p>
  <a class="btn btn--wa" href={linkWhatsApp(site.whatsappPrincipal, 'Olá! Quero ser avisado dos próximos destinos da KeepTrack.')} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="card-em-breve">
    <Icone nome="whatsapp" />Quero ser avisado
  </a>
</article>
<style>
  .em-breve { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: .2rem; min-height: 100%; padding: clamp(1.5rem, 3vw, 2.2rem); border-radius: var(--raio-g); background: linear-gradient(160deg, var(--azul), var(--azul-escuro)); color: #dfe6f5; overflow: hidden; }
  .em-breve > :global(svg) { width: 44px; color: #9fb6e6; margin-bottom: .8rem; }
  .em-breve h3 { color: #fff; font-size: 2rem; margin: .2rem 0 .4rem; }
  .em-breve p { margin: 0 0 1.2rem; }
  .em-breve .eyebrow { margin: 0; }
</style>
