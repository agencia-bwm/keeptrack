---
// Cartão lateral fixo (sticky) das páginas de produto: fatos + botão WhatsApp
import Icone from './Icone.astro';
import { getSite, linkWhatsApp } from '../lib/utils';
interface Props {
  fatos: { icone: 'calendario' | 'relogio' | 'local' | 'nivel' | 'carro' | 'pessoas' | 'rota'; rotulo: string; valor: string }[];
  destaque?: { rotulo: string; valor: string };
  preco?: string;
  whatsappTexto: string;
  produto: string;
  botao?: string;
  /** turmas abertas: a ficha mostra a escolhida e troca a mensagem do WhatsApp */
  datas?: { id: string; rotulo: string; curto: string; whatsapp: string }[];
}
const { fatos, destaque, preco, whatsappTexto, produto, botao = 'Quero participar', datas = [] } = Astro.props;
const site = await getSite();
---
<aside class="ficha" aria-label="Resumo">
  {destaque && (
    <div class="destaque"><span data-ficha-rotulo>{destaque.rotulo}</span><strong data-ficha-data>{destaque.valor}</strong></div>
  )}
  {datas.length > 1 && (
    <fieldset class="datas">
      <legend>Escolha a turma</legend>
      <div class="datas-lista">
        {datas.map((t, i) => (
          <label>
            <input type="radio" name="ficha-turma" value={t.id} checked={i === 0}
              data-rotulo={t.rotulo} data-wa={linkWhatsApp(site.whatsappPrincipal, t.whatsapp)} />
            <span>{t.curto}</span>
          </label>
        ))}
      </div>
    </fieldset>
  )}
  <dl>
    {fatos.map((f) => (
      <div><dt><Icone nome={f.icone} />{f.rotulo}</dt><dd>{f.valor}</dd></div>
    ))}
  </dl>
  {preco && <p class="preco">{preco}</p>}
  <a class="btn btn--wa btn--bloco" data-ficha-wa href={linkWhatsApp(site.whatsappPrincipal, whatsappTexto)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="ficha" data-produto={produto}>
    <Icone nome="whatsapp" />{botao}
  </a>
  <p class="nota">Atendimento direto com a equipe, sem formulário.</p>
</aside>
<script>
  // Troca a data em destaque e a mensagem do WhatsApp conforme a turma escolhida (ou ?turma= na URL)
  const ficha = document.querySelector('.ficha');
  const radios = ficha ? [...ficha.querySelectorAll<HTMLInputElement>('input[name="ficha-turma"]')] : [];
  if (ficha && radios.length) {
    const aplicar = (r: HTMLInputElement, primeira: boolean) => {
      r.checked = true;
      ficha.querySelector('[data-ficha-data]')!.textContent = r.dataset.rotulo!;
      ficha.querySelector('[data-ficha-rotulo]')!.textContent = primeira ? 'Próxima turma' : 'Turma escolhida';
      ficha.querySelector<HTMLAnchorElement>('[data-ficha-wa]')!.href = r.dataset.wa!;
    };
    radios.forEach((r, i) => r.addEventListener('change', () => aplicar(r, i === 0)));
    const pedida = new URLSearchParams(location.search).get('turma');
    const idx = radios.findIndex((r) => r.value === pedida);
    if (idx > 0) aplicar(radios[idx], false);
  }
</script>
<style>
  .ficha { position: sticky; top: 100px; background: var(--branco); border-radius: var(--raio-g); padding: 1.5rem; box-shadow: var(--sombra-forte), inset 0 0 0 1px rgb(18 29 61 / .05); }
  .destaque { background: linear-gradient(135deg, var(--azul), var(--azul-escuro)); color: #fff; border-radius: var(--raio); padding: .9rem 1rem; margin-bottom: 1.2rem; }
  .destaque span { display: block; font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: #dbe5fa; font-weight: 600; }
  .destaque strong { font-family: var(--f-titulo); font-size: 1.7rem; text-transform: uppercase; line-height: 1.1; }
  dl { margin: 0 0 1.2rem; display: grid; gap: .9rem; }
  dt { display: flex; align-items: center; gap: .45em; font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; color: var(--cinza); font-weight: 600; }
  dt :global(svg) { width: 16px; color: var(--azul); }
  dd { margin: .15rem 0 0; font-weight: 600; color: var(--azul-escuro); }
  .preco { font-weight: 600; padding: .8rem 0; border-top: 1px solid var(--linha); margin: 0 0 1rem; }
  .datas { border: 0; padding: 0; margin: -.4rem 0 1.2rem; }
  .datas legend { font-size: .82rem; letter-spacing: .1em; text-transform: uppercase; color: var(--cinza); font-weight: 600; margin-bottom: .5rem; }
  .datas-lista { display: flex; flex-wrap: wrap; gap: .4rem; }
  .datas label { position: relative; cursor: pointer; }
  .datas input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .datas span { display: inline-block; padding: .4rem .75rem; border-radius: 999px; border: 1px solid var(--linha); font-weight: 600; font-size: .92rem; color: var(--azul-escuro); background: var(--branco); transition: background .2s, color .2s, border-color .2s; }
  .datas label:hover span { border-color: var(--azul); }
  .datas input:checked + span { background: var(--azul); border-color: var(--azul); color: #fff; }
  .datas input:focus-visible + span { outline: 2px solid var(--azul); outline-offset: 2px; }
  .nota { font-size: .88rem; color: var(--cinza); text-align: center; margin: .7rem 0 0; }
</style>
