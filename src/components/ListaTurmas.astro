---
import Icone from './Icone.astro';
import { diaMes, linkWhatsApp, rotulos, getSite, dataCurta } from '../lib/utils';
interface Turma { data: Date; horario?: string; local?: string; vagas?: number; status: 'aberta' | 'esgotada' | 'realizada' }
interface Props {
  turmas: Turma[]; localPadrao: string; titulo: string; mostrarTreinamento?: string[];
  /** link da página do treinamento de cada turma (home e listagem) */
  links?: string[];
  /** aviso abaixo da lista (ex.: calendário do próximo ano) */
  aviso?: string;
}
const { turmas, localPadrao, titulo, mostrarTreinamento, links, aviso } = Astro.props;
const site = await getSite();
---
{turmas.length ? (
  <ol class="turmas">
    {turmas.map((t, i) => {
      const dm = diaMes(t.data);
      const nome = mostrarTreinamento?.[i] ?? titulo;
      const iso = t.data.toISOString().slice(0, 10);
      const link = links?.[i] ? `${links[i]}?turma=${iso}` : undefined;
      return (
        <li class="turma">
          <div class="data"><span class="dia">{dm.dia}</span><span class="mes">{dm.mes}<span class="ano">{dm.ano}</span></span></div>
          <div class="info">
            {mostrarTreinamento && <p class="nome">{link ? <a href={link}>{nome}</a> : nome}</p>}
            <p><Icone nome="calendario" /><span>{dm.semana.charAt(0).toUpperCase() + dm.semana.slice(1)}</span>{t.horario && <> · {t.horario}</>}</p>
            <p><Icone nome="local" />{t.local ?? localPadrao}</p>
            {typeof t.vagas === 'number' && <p><Icone nome="pessoas" />{t.vagas} vagas</p>}
          </div>
          <div class="acao">
            <span class:list={['selo', `selo--${t.status}`]}>{rotulos.statusTurma[t.status]}</span>
            <div class="botoes">
            {link && (
              <a class="btn btn--contorno" href={link} data-track="click_mais_info" data-local="turma" data-produto={nome}>Mais informações</a>
            )}
            {t.status === 'aberta' && (
              <a class="btn btn--wa" href={linkWhatsApp(site.whatsappPrincipal, `Olá! Quero me inscrever na turma de ${dataCurta(t.data)} do treinamento ${nome}.`)}
                 target="_blank" rel="noopener" data-track="click_whatsapp" data-local="turma" data-produto={nome}>
                <Icone nome="whatsapp" />Garantir vaga
              </a>
            )}
            </div>
          </div>
        </li>
      );
    })}
  </ol>
) : null}
{turmas.length > 0 && aviso && (
  <div class="aviso">
    <Icone nome="calendario" />
    <p>{aviso}</p>
    <a class="link-seta" href={linkWhatsApp(site.whatsappPrincipal, `Olá! Quero ser avisado das novas turmas do treinamento ${titulo}.`)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="aviso-turmas" data-produto={titulo}>Quero ser avisado</a>
  </div>
)}
{turmas.length ? null : (
  <div class="vazio">
    <p><strong>Novas turmas em breve.</strong> {aviso ?? 'Chame no WhatsApp para entrar na lista de espera e ser avisado primeiro.'}</p>
    <a class="btn btn--wa" href={linkWhatsApp(site.whatsappPrincipal, `Olá! Quero ser avisado das próximas turmas do treinamento ${titulo}.`)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="lista-espera" data-produto={titulo}><Icone nome="whatsapp" />Entrar na lista</a>
  </div>
)}
<style>
  .aviso { margin-top: 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; padding: 1rem 1.2rem; border-radius: var(--raio-g); border: 1px dashed rgb(63 104 185 / .45); background: rgb(63 104 185 / .05); }
  .aviso > :global(svg) { width: 22px; color: var(--azul); flex: none; }
  .aviso p { margin: 0; flex: 1 1 280px; font-weight: 500; color: var(--azul-escuro); }
  .turmas { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; }
  .turma { display: grid; grid-template-columns: auto 1fr auto; gap: 1.2rem; align-items: center; background: var(--branco); border-radius: var(--raio-g); padding: .8rem 1.2rem .8rem .8rem; box-shadow: var(--sombra), inset 0 0 0 1px rgb(18 29 61 / .05); }
  .data { width: 80px; text-align: center; background: linear-gradient(160deg, var(--azul), var(--azul-escuro)); border-radius: var(--raio); padding: .55rem 0; font-family: var(--f-titulo); text-transform: uppercase; line-height: 1; }
  .dia { display: block; font-size: 2.3rem; font-weight: 700; color: #fff; }
  .mes { font-size: .85rem; letter-spacing: .08em; color: #c5d0ea; }
  .info p { margin: 0; display: flex; align-items: center; gap: .5em; font-size: .98rem; }
  .info p + p { margin-top: .2rem; }
  .info :global(svg) { width: 17px; color: var(--azul); flex: none; }
  .nome { font-family: var(--f-titulo); font-weight: 700; font-size: 1.3rem !important; text-transform: uppercase; color: var(--azul-escuro); }
  .cap { text-transform: capitalize; }
  .acao { display: flex; flex-direction: column; align-items: flex-end; gap: .6rem; }
  .acao .btn { min-height: 44px; font-size: 1rem; }
  .vazio { background: var(--bege); border-radius: var(--raio-g); padding: 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; justify-content: space-between; }
  .vazio p { margin: 0; max-width: 52ch; }
  @media (max-width: 640px) {
    .turma { grid-template-columns: auto 1fr; }
    .acao { grid-column: 1 / -1; flex-direction: column; align-items: stretch; }
    .acao .selo { align-self: flex-start; }
  }
  .ano { display: block; margin-top: .2em; font-size: .78rem; letter-spacing: .1em; }
  .nome a { color: inherit; text-decoration: none; }
  .nome a:hover { color: var(--azul); text-decoration: underline; text-underline-offset: .15em; }
  .botoes { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: flex-end; }
  .botoes .btn { min-height: 44px; font-size: 1rem; }
  @media (max-width: 640px) { .botoes { justify-content: stretch; } .botoes .btn { flex: 1 1 100%; } }
</style>
