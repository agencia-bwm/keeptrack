---
import { getCollection, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import RespostaDireta from '../../components/RespostaDireta.astro';
import FichaProduto from '../../components/FichaProduto.astro';
import ListaTurmas from '../../components/ListaTurmas.astro';
import Galeria from '../../components/Galeria.astro';
import FAQ from '../../components/FAQ.astro';
import CardEquipe from '../../components/CardEquipe.astro';
import CardPost from '../../components/CardPost.astro';
import CardTreinamento from '../../components/CardTreinamento.astro';
import CTAFinal from '../../components/CTAFinal.astro';
import Foto from '../../components/Foto.astro';
import { proximasTurmas, rotulos, diaMes, getPosts, getTreinamentos } from '../../lib/utils';
import { schemaBreadcrumb, schemaCurso, schemaFaq } from '../../lib/schema';

export async function getStaticPaths() {
  const ts = await getCollection('treinamentos');
  return ts.map((t) => ({ params: { slug: t.id }, props: { t } }));
}

const { t } = Astro.props;
const d = t.data;
const { Content } = await render(t);
const turmas = proximasTurmas(t);
const prox = turmas[0];
const instrutores = await getEntries(d.instrutores);
const url = new URL(Astro.url.pathname, Astro.site).href;
const waTexto = d.whatsapp ?? `Olá! Quero saber mais sobre o treinamento ${d.titulo}.`;
const posts = (await getPosts()).filter((p) => p.data.relacionadosTreinamentos.some((r) => r.id === t.id)).slice(0, 3);
const outros = (await getTreinamentos()).filter((x) => x.id !== t.id);

const migalhas = [
  { nome: 'Início', url: '/' },
  { nome: 'Treinamentos', url: '/treinamentos/' },
  { nome: d.titulo, url: Astro.url.pathname },
];
const schema = [
  schemaBreadcrumb(migalhas, Astro.site!),
  schemaCurso(t, turmas, url, Astro.site!, instrutores.map((i) => i.data)),
  ...schemaFaq(d.faq),
];
const dm = prox ? diaMes(prox.data) : null;
const reais = (n: number) => n.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
---
<BaseLayout titulo={d.seo.titulo} descricao={d.seo.descricao} imagem={d.capa} preloadImagem={d.capa} schema={schema}
  whatsappTexto={waTexto} produto={d.titulo} tipoProduto="treinamento">
  <PageHero titulo={d.titulo} eyebrow={`Treinamento · ${rotulos.modalidade[d.modalidade]}`} subtitulo={d.resumo} imagem={d.capa} imagemAlt={d.capaAlt} migalhas={migalhas} />

  <div class="container produto">
    <div class="principal">
      <RespostaDireta texto={d.resposta} />

      {t.body?.trim() && <div class="prosa intro"><Content /></div>}

      {d.sobreLocal && (
        <section class="bloco local-card">
          {d.sobreLocal.logo && <div class="local-logo"><Foto src={d.sobreLocal.logo} alt={`Logo do ${d.sobreLocal.nome}`} largura={200} /></div>}
          <div>
            <p class="eyebrow">Onde acontece</p>
            <h2>{d.sobreLocal.nome}</h2>
            <p>{d.sobreLocal.texto}</p>
          </div>
        </section>
      )}

      <section class="bloco">
        <h2>O que você vai aprender</h2>
        <ol class="conteudo">{d.conteudo.map((c) => <li>{c}</li>)}</ol>
      </section>

      {d.programacao.length > 0 && (
        <section class="bloco">
          <h2>Programação do dia</h2>
          <ol class="agenda-dia">
            {d.programacao.map((p) => <li><span class="hora">{p.hora}</span><span class="ativ">{p.atividade}</span></li>)}
          </ol>
          {d.observacao && <p class="obs"><strong>Observação:</strong> {d.observacao}</p>}
        </section>
      )}

      {d.modalidade === 'grupo' && (
        <section class="bloco" id="turmas">
          <h2>Próximas turmas</h2>
          <ListaTurmas turmas={turmas} localPadrao={d.local} titulo={d.titulo} />
        </section>
      )}

      {d.planos.length > 0 && (
        <section class="bloco" id="valores">
          <h2>Valores</h2>
          <div class="planos">
            {d.planos.map((pl) => (
              <article class:list={['plano', { destaque: pl.destaque }]}>
                {pl.destaque && <span class="selo selo--azul plano-selo">Mais procurado</span>}
                <h3>{pl.nome}{pl.subtitulo && <small>{pl.subtitulo}</small>}</h3>
                <p class="valor"><span>R$</span>{reais(pl.valor)}</p>
                <p class="por">{pl.nome === 'Grupo' ? 'por veículo' : 'por treinamento'}</p>
                <p class="desc">{pl.descricao}</p>
              </article>
            ))}
          </div>
          {d.extras.length > 0 && (
            <ul class="extras">
              {d.extras.map((x) => (
                <li><div><strong>{x.nome}</strong><span>{x.descricao}</span></div><b>R$ {reais(x.valor)}</b></li>
              ))}
            </ul>
          )}
          {d.pagamento.length > 0 && (
            <div class="pagamento">
              <h3>Forma de pagamento</h3>
              <ul>{d.pagamento.map((pg) => <li><strong>{pg.titulo}</strong><span>{pg.texto}</span></li>)}</ul>
            </div>
          )}
        </section>
      )}

      {(d.inclui.length > 0 || d.naoInclui.length > 0) && (
        <section class="bloco duas">
          {d.inclui.length > 0 && <div><h2>O que inclui</h2><ul class="lista-check">{d.inclui.map((c) => <li>{c}</li>)}</ul></div>}
          {d.naoInclui.length > 0 && <div><h2>Não inclui</h2><ul class="lista-check lista-x">{d.naoInclui.map((c) => <li>{c}</li>)}</ul></div>}
        </section>
      )}

      <section class="bloco duas">
        <div>
          <h2>Para quem é</h2>
          <ul class="lista-check">{d.paraQuem.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div>
          <h2>Requisitos</h2>
          <ul class="lista-check">{d.requisitos.map((c) => <li>{c}</li>)}</ul>
        </div>
      </section>

      {d.galeria.length > 0 && (
        <section class="bloco">
          <h2>Fotos do treinamento</h2>
          <Galeria fotos={d.galeria} />
        </section>
      )}

      {instrutores.length > 0 && (
        <section class="bloco">
          <h2>{instrutores.length > 1 ? 'Quem conduz o treinamento' : 'Instrutor'}</h2>
          <div class="instrutores">{instrutores.map((i) => <CardEquipe pessoa={i} variante="compacto" />)}</div>
        </section>
      )}

      {d.faq.length > 0 && (
        <section class="bloco">
          <h2>Perguntas frequentes</h2>
          <FAQ itens={d.faq} />
        </section>
      )}
    </div>

    <FichaProduto
      destaque={dm ? { rotulo: 'Próxima turma', valor: `${dm.dia} ${dm.mes} ${dm.ano}` } : undefined}
      fatos={[
        { icone: 'relogio', rotulo: 'Carga horária', valor: d.cargaHoraria },
        { icone: 'local', rotulo: 'Local', valor: d.local },
        { icone: 'nivel', rotulo: 'Nível', valor: rotulos.nivel[d.nivel] },
        { icone: 'carro', rotulo: 'Veículo', valor: d.requisitos[0] },
      ]}
      preco={d.preco?.valor ? `A partir de R$ ${reais(d.preco.valor)}${d.preco.texto ? ' ' + d.preco.texto : ''}` : d.preco?.texto}
      whatsappTexto={waTexto}
      produto={d.titulo}
      botao={d.modalidade === 'corporativo' ? 'Pedir proposta' : d.modalidade === 'personalizado' ? 'Combinar data' : 'Garantir vaga'}
    />
  </div>

  {posts.length > 0 && (
    <section class="secao secao--bege">
      <div class="container">
        <div class="cabecalho-secao"><div><p class="eyebrow">Dicas 4x4</p><h2>Leia também</h2></div></div>
        <div class="grade">{posts.map((p) => <CardPost post={p} />)}</div>
      </div>
    </section>
  )}

  {outros.length > 0 && (
    <section class="secao">
      <div class="container">
        <div class="cabecalho-secao"><div><p class="eyebrow">Treinamentos</p><h2>Outras modalidades</h2></div></div>
        <div class="grade">{outros.map((o) => <CardTreinamento treinamento={o} />)}</div>
      </div>
    </section>
  )}

  <CTAFinal titulo="Pronto para o próximo nível?" whatsappTexto={waTexto} produto={d.titulo} />
</BaseLayout>

<style>
  .produto { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; padding-block: clamp(40px, 6vw, 72px) var(--sec); }
  .intro { margin-top: 2rem; }
  .bloco { margin-top: clamp(48px, 6vw, 72px); }
  .bloco h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .duas { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; }
  .h-inclui { margin-top: 2rem; }
  .conteudo { list-style: none; counter-reset: c; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .8rem 1.5rem; }
  .conteudo li { counter-increment: c; display: flex; gap: .9rem; align-items: baseline; padding: .9rem 1rem; background: var(--bege); border-radius: var(--raio); }
  .conteudo li::before { content: counter(c, decimal-leading-zero); font-family: var(--f-titulo); font-weight: 700; font-size: 1.3rem; color: var(--azul); }
  @media (max-width: 960px) {
    .produto { grid-template-columns: 1fr; }
    .produto :global(.ficha) { position: static; grid-row: 1; }
  }
  @media (max-width: 640px) { .duas, .conteudo { grid-template-columns: 1fr; } }
  .local-card { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem 2rem; align-items: center; padding: clamp(1.4rem, 3vw, 2rem); background: var(--bege); border-radius: var(--raio-g); }
  .local-card h2 { margin-bottom: .3em; }
  .local-card p:last-child { margin: 0; color: var(--cinza); }
  .local-logo { width: clamp(110px, 16vw, 170px); background: #fff; border-radius: var(--raio); padding: .8rem; box-shadow: var(--sombra); }
  .local-logo :global(img) { width: 100%; height: auto; }
  .agenda-dia { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--azul); }
  .agenda-dia li { display: grid; grid-template-columns: 120px 1fr; gap: 1rem; align-items: baseline; padding: .7rem 0 .7rem 1.4rem; position: relative; }
  .agenda-dia li::before { content: ''; position: absolute; left: -7px; top: 1.15rem; width: 12px; height: 12px; border-radius: 3px; background: var(--azul); }
  .hora { font-family: var(--f-titulo); font-weight: 700; font-size: 1.35rem; color: var(--azul-escuro); text-transform: uppercase; }
  .ativ { font-weight: 500; }
  .obs { margin-top: 1.2rem; font-size: .95rem; color: var(--cinza); padding: .9rem 1.1rem; border-radius: var(--raio); background: var(--bege); }
  .planos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .plano { position: relative; padding: 1.6rem; border-radius: var(--raio-g); background: var(--branco); box-shadow: var(--sombra), inset 0 0 0 1px rgb(18 29 61 / .08); }
  .plano.destaque { background: linear-gradient(150deg, #24397a, var(--azul-escuro)); color: #dfe6f5; box-shadow: var(--sombra-forte); }
  .plano h3 { font-size: 1.9rem; margin: 0; display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; }
  .plano h3 small { font-size: .9rem; letter-spacing: .12em; color: var(--azul); }
  .plano.destaque h3, .plano.destaque .valor { color: #fff; }
  .plano.destaque h3 small { color: #9fb6e6; }
  .plano-selo { position: absolute; top: 1.2rem; right: 1.2rem; }
  .valor { font-family: var(--f-titulo); font-weight: 700; font-size: clamp(2.6rem, 5vw, 3.2rem); line-height: 1; margin: 1rem 0 .1rem; color: var(--azul-escuro); font-variant-numeric: tabular-nums; }
  .valor span { font-size: .45em; margin-right: .25em; vertical-align: .9em; }
  .por { font-size: .9rem; color: var(--cinza); margin: 0 0 1rem; }
  .plano.destaque .por { color: #c5d0ea; }
  .desc { margin: 0; font-size: .98rem; }
  .extras { list-style: none; margin: 1rem 0 0; padding: 0; border-radius: var(--raio-g); background: var(--bege); }
  .extras li { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1rem 1.3rem; }
  .extras li + li { border-top: 1px solid var(--bege-2); }
  .extras strong { display: block; color: var(--azul-escuro); }
  .extras span { display: block; font-size: .92rem; color: var(--cinza); }
  .extras b { font-family: var(--f-titulo); font-size: 1.5rem; color: var(--azul-escuro); white-space: nowrap; }
  .pagamento { margin-top: 1.4rem; }
  .pagamento h3 { font-size: 1.3rem; margin-bottom: .7rem; }
  .pagamento ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .pagamento li { padding: 1rem; border-radius: var(--raio); box-shadow: inset 0 0 0 1.5px rgb(63 104 185 / .3); }
  .pagamento li strong { display: block; font-family: var(--f-titulo); font-size: 1.3rem; text-transform: uppercase; color: var(--azul); }
  .pagamento li span { font-size: .92rem; color: var(--cinza); }
  @media (max-width: 640px) {
    .local-card, .planos, .pagamento ul { grid-template-columns: 1fr; }
    .agenda-dia li { grid-template-columns: 1fr; gap: .1rem; }
    .extras li { flex-direction: column; align-items: flex-start; gap: .3rem; }
  }
  .instrutores { display: grid; gap: 1rem; }
</style>
